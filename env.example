# Example Environment Configuration for Local Development
# Copy this file to .env and update with your actual values

# Model Configuration
MODEL_ENDPOINT=http://localhost:8000/v1/chat/completions

# Elasticsearch Configuration
ELASTIC_URL=http://localhost:9200
ELASTIC_PASS=your_elastic_password_here

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_RUN_ON_SAVE=true

# Optional: Model-specific settings
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=1000

# Optional: Elasticsearch index settings
ELASTIC_INDEX_NAME=documents
ELASTIC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
